{
  "name": "cards",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node tools/serve.ts",
    "dev": "node tools/serve.ts",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "measure": "node src/sim/measure.ts",
    "verify": "node src/sim/measure.ts --verify --seeds 400 --sweep-seeds 400 --search-check 200",
    "measure:ablate": "node src/sim/ablate.ts",
    "measure:run": "node src/sim/runmeasure.ts --seeds 1000",
    "verify:run": "node src/sim/runmeasure.ts --verify --seeds 200 --check-seeds 20",
    "probe:heraldry": "node tools/heraldry-probe/shoot.ts",
    "probe:ui": "node tools/ui-probe/play.ts",
    "probe:icons": "node tools/ui-probe/icons.ts",
    "gate:boundaries": "node tools/gates/boundaries.ts",
    "gate:banned-apis": "node tools/gates/banned-apis.ts",
    "gate:work-plans": "node tools/gates/work-plans.ts",
    "audit": "npm audit --audit-level=high",
    "gates": "npm run typecheck && npm run gate:boundaries && npm run gate:banned-apis && npm run gate:work-plans && npm test && npm run verify && npm run verify:run"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "playwright-core": "1.56.1",
    "typescript": "^5.9.3"
  }
}
